{
  "key": "2026-09-20:legend:flying-dutchman",
  "phase": "visual-inputs-ready",
  "not_final_video": true,
  "scenes": [
    {
      "file": "scene-01.jpg",
      "source_art": "dix",
      "script": "Ο θρύλος λέει πως, αν αυτό το πλοίο σε πλησιάσει, δεν πρέπει να δεχτείς τα γράμματά του.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-02.jpg",
      "source_art": "ryder",
      "script": "Είναι ο Ιπτάμενος Ολλανδός. Το καράβι που δεν βρίσκει ποτέ λιμάνι.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-03.jpg",
      "source_art": "cruikshank",
      "script": "Και η κατάρα του ξεκίνησε από έναν όρκο.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-04.jpg",
      "source_art": "strindberg",
      "script": "Σε μια εκδοχή του θρύλου, ένας καπετάνιος προσπαθεί να περάσει το Ακρωτήριο της Καλής Ελπίδας μέσα σε φοβερή καταιγίδα.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-05.jpg",
      "source_art": "dix",
      "script": "Ο άνεμος τον σπρώχνει πίσω. Εκείνος, όμως, αρνείται να υποχωρήσει.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-06.jpg",
      "source_art": "cruikshank",
      "script": "Ορκίζεται ότι θα περάσει, ακόμη κι αν ταξιδεύει για πάντα.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-07.jpg",
      "source_art": "gehrts",
      "script": "Και τότε, λέει η ιστορία, ο όρκος γίνεται καταδίκη.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-08.jpg",
      "source_art": "cawse",
      "script": "Το πλοίο συνεχίζει να πλέει. Μόνο που κανείς δεν επιστρέφει σπίτι.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-09.jpg",
      "source_art": "ryder",
      "script": "Οι ναυτικοί το περιγράφουν με παράξενη λάμψη. Με πανιά φουσκωμένα, ακόμη κι όταν η θάλασσα είναι ακίνητη.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-10.jpg",
      "source_art": "kingsley",
      "script": "Το πιο ανατριχιαστικό, όμως, δεν είναι το πλοίο.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-11.jpg",
      "source_art": "gehrts",
      "script": "Είναι το πλήρωμά του, που ζητά από περαστικούς να μεταφέρουν γράμματα στη στεριά.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-12.jpg",
      "source_art": "cawse",
      "script": "Γράμματα για τους ανθρώπους που άφησαν πίσω. Μηνύματα από ένα ταξίδι που δεν τελειώνει.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-13.jpg",
      "source_art": "kingsley",
      "script": "Κι όποιος τα δεχτεί, λένε, φέρνει την κακοτυχία κοντά του.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-14.jpg",
      "source_art": "strindberg",
      "script": "Αυτά ανήκουν στη ναυτική παράδοση, όχι σε αποδεδειγμένο υπερφυσικό γεγονός. Αλλά ο φόβος πίσω από τον θρύλο είναι βαθιά ανθρώπινος:",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    },
    {
      "file": "scene-15.jpg",
      "source_art": "dix",
      "script": "να περάσει όλη σου η ζωή ταξιδεύοντας, χωρίς να φτάσεις ποτέ εκεί όπου σε περιμένουν.",
      "voice_id": "8bc71625549d425d9a38b4e4a296ba32"
    }
  ],
  "credits_file": "credits.jpg",
  "credits_hold_seconds": 7,
  "closing_file": "closing.jpg",
  "closing_script": "Αν σας άρεσε, ακολουθήστε για περισσότερα.",
  "source_art_count": 7,
