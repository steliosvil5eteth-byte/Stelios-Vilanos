# Bootstrap admin (optional after users exist). Store only the SHA-256, never plaintext.
APP_USER=stelios
APP_PASSWORD_SHA256=<sha256-of-password>
SESSION_SECRET=<at-least-32-random-characters>
APP_DISPLAY_NAME=Stelios
APP_EMAIL=
APP_BASE_URL=https://your-domain.example

# Preferred production storage: PostgreSQL.
DATABASE_URL=
# Optional persistent KV/Redis fallback if DATABASE_URL is not supplied.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protected full credential backup.
BACKUP_EXPORT_SECRET=<separate-random-secret>

# Transactional email. current release supports disabled | memory | resend.
# Use memory only for local tests. Production: EMAIL_MODE=resend.
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=Trading Control Center <noreply@your-domain.example>
ADMIN_ALERT_EMAIL=
# Never enable in production. Exposes one-time verification tokens in API responses for local testing only.
EXPOSE_DEV_TOKENS=false

# Stripe billing adapter: current release accepts ONLY stripe_test and an sk_test_ key.
# There is intentionally no live billing mode or live-charge endpoint.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Optional market data. current release supports provider failover.
MARKET_DATA_PROVIDER=auto
MARKET_DATA_FAILOVER=true
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_OUTPUTSIZE=compact
TWELVE_DATA_API_KEY=
TWELVE_DATA_OUTPUTSIZE=1000
SCAN_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META

# Secure cron endpoints (daily research scan / optional health monitor).
CRON_SECRET=

# IBKR Trading Web API / supported authenticated proxy.
# Submission remains paper-only and requires isPaper=true.
IBKR_BASE_URL=
IBKR_ACCOUNT_ID=
IBKR_BEARER_TOKEN=
IBKR_PAPER_EXECUTION_ENABLED=false

# Global paper execution safety. Both env permission and admin switch are required.
PAPER_EXECUTION_ENABLED=false
MARKET_DATA_MAX_AGE_DAYS=7

# Release controls
MAINTENANCE_DEFAULT=false
