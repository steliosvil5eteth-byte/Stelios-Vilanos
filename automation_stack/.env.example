# Copy to .env LOCALLY. Do not commit actual credentials.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_KEY
# Pin an audited exact version for production. 'stable' is for local staging only.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable