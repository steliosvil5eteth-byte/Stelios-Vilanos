# Bootstrap admin (optional after users exist). Store only the SHA-256, never plaintext.
APP_USER=stelios
APP_PASSWORD_SHA256=<sha256-of-password>
SESSION_SECRET=<at-least-32-random-characters>
APP_DISPLAY_NAME=Stelios
APP_EMAIL=
APP_BASE_URL=https://your-domain.example

# Preferred production storage: PostgreSQL.
DATABASE_URL=
# Optional persistent KV/Redis fallback if DATABASE_URL is not supplied.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protected full credential backup.
BACKUP_EXPORT_SECRET=<separate-random-secret>

# Transactional email. v1.3 supports disabled | memory | resend.
# Use memory only for local tests. Production: EMAIL_MODE=resend.
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=Trading Control Center <noreply@your-domain.example>
ADMIN_ALERT_EMAIL=
# Never enable in production. Exposes one-time verification tokens in API responses for local testing only.
EXPOSE_DEV_TOKENS=false

# Stripe billing adapter: v1.3 accepts ONLY stripe_test and an sk_test_ key.
# There is intentionally no live billing mode or live-charge endpoint.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Optional market data. v1.4 supports provider failover.
MARKET_DATA_PROVIDER=auto
MARKET_DATA_FAILOVER=true
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_OUTPUTSIZE=compact
TWELVE_DATA_API_KEY=
TWELVE_DATA_OUTPUTSIZE=1000

# Intraday signal engine (development/basic Twelve Data can be used subject to provider terms).
SIGNAL_REQUIRE_INTRADAY=true
SIGNAL_INTERVAL=5min
SIGNAL_INTRADAY_OUTPUTSIZE=300
INTRADAY_MAX_AGE_MINUTES=30
SIGNAL_MARKET_CACHE_SECONDS=120

# Scheduled signal watch. Disabled by default to avoid accidental API usage/cost.
SIGNAL_AUTOWATCH_ENABLED=false
SIGNAL_AUTOWATCH_MAX_USERS=20
SCAN_SYMBOLS=AAPL,MSFT,NVDA,AMZN,META

# Signal-first event confirmation.
# Alpha Vantage NEWS_SENTIMENT can use the same development API key above.
EVENT_CONFIRMATION_REQUIRED=true
EVENT_LOOKBACK_HOURS=24
EVENT_MIN_SCORE=80
EVENT_CACHE_MINUTES=10
# Required only if SEC EDGAR filing checks are enabled. Use a real identifying contact per SEC fair-access rules.
SEC_USER_AGENT=

# Secure cron endpoints (daily research scan / optional health monitor).
CRON_SECRET=

# IBKR Trading Web API / supported authenticated proxy.
# Submission remains paper-only and requires isPaper=true.
IBKR_BASE_URL=
IBKR_ACCOUNT_ID=
IBKR_BEARER_TOKEN=
IBKR_PAPER_EXECUTION_ENABLED=false
\n# v1.6 release controls\nMAINTENANCE_DEFAULT=false\n